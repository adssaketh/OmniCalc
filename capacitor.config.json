{
  "appId": "com.saketh.omnicalc",
  "appName": "OmniCalc",
  "webDir": "dist",
  "backgroundColor": "#111318",
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#111318",
      "overlaysWebView": false
    },
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#111318",
      "showSpinner": false
    }
  },
  "android": {
    "backgroundColor": "#111318",
    "allowMixedContent": false,
    "captureInput": true
  }
}
